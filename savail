#!/bin/bash

# check available and requested CPU, memory, and GPU for mixed Slurm nodes

# Default values
PARTITION=""
TOPN=10

# Display help function
show_help() {
    echo "Usage: savail [-p partition[,partition...]] [-n topn]"
    echo "  -p PARTITION   Filter by Slurm partition(s), comma-separated (default: all)"
    echo "  -n TOPN        Number of top mixed nodes to display by available CPU (default: $TOPN)"
    echo "  -h             Display this help message"
    exit 0
}

# Parse command line arguments
while getopts "p:n:h" opt; do
  case $opt in
    p)
      PARTITION="$OPTARG"
      ;;
    n)
      TOPN="$OPTARG"
      ;;
    h)
      show_help
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      echo "Use -h for help" >&2
      exit 1
      ;;
    :)
      echo "Option -$OPTARG requires an argument." >&2
      echo "Use -h for help" >&2
      exit 1
      ;;
  esac
done

# Get all node info once
all_node_info=$(scontrol show node -o)

# Filter by partition(s)
if [ -n "$PARTITION" ]; then
    IFS=',' read -ra PART_ARRAY <<< "$PARTITION"
    node_info=""
    for p in "${PART_ARRAY[@]}"; do
        part_nodes=$(echo "$all_node_info" | grep "Partitions=\<$p\>")
        node_info="$node_info"$'\n'"$part_nodes"
    done
    # Remove empty lines and deduplicate
    node_info=$(echo "$node_info" | sed '/^$/d' | sort -u)
else
    node_info="$all_node_info"
fi

if [ -z "$node_info" ]; then
    echo "No nodes found."
    exit 0
fi

# Collect node details and print summary table
echo "$node_info" | awk -v topn="$TOPN" '{
    # Check State and Partitions
    state=""; partitions=""
    for (i=1; i<=NF; i++) {
        if ($i ~ /^State=/)      { split($i, a, "="); state=a[2] }
        if ($i ~ /^Partitions=/) { split($i, a, "="); partitions=a[2] }
    }
    if (partitions == "") next
    if (state == "IDLE") idle[partitions]++
    if (state != "MIXED") next

    # Parse detailed fields only for MIXED nodes
    name=""; cputot=0; cpualloc=0; realmem=0; gres_str=""; tres_str=""
    for (i=1; i<=NF; i++) {
        if ($i ~ /^NodeName=/)   { split($i, a, "="); name=a[2] }
        if ($i ~ /^CPUTot=/)     { split($i, a, "="); cputot=a[2] }
        if ($i ~ /^CPUAlloc=/)   { split($i, a, "="); cpualloc=a[2] }
        if ($i ~ /^RealMemory=/) { split($i, a, "="); realmem=a[2] }
        if ($i ~ /^Gres=/)       { sub(/^Gres=/, "", $i); gres_str = $i }
        if ($i ~ /^AllocTRES=/)  { sub(/^AllocTRES=/, "", $i); tres_str = $i }
    }
    mixed[partitions]++
    avail_cpu = cputot - cpualloc

    # Parse AllocTRES for allocated memory: keep MB for calc, GB for display
    alloc_mem_mb = 0
    alloc_mem_gb = 0
    if (tres_str != "") {
        ntres = split(tres_str, tres_arr, ",")
        for (t=1; t<=ntres; t++) {
            if (tres_arr[t] ~ /^mem=/) {
                memval = tres_arr[t]
                sub(/^mem=/, "", memval)
                if (memval ~ /[Gg]$/) {
                    sub(/[Gg]$/, "", memval)
                    alloc_mem_mb = (memval + 0) * 1024
                    alloc_mem_gb = (memval + 0)
                } else {
                    sub(/[Mm]$/, "", memval)
                    alloc_mem_mb = (memval + 0)
                    alloc_mem_gb = (memval + 0) / 1024
                }
            }
        }
    }

    # Available memory = total RAM - Slurm-allocated (both in MB), convert to GB
    avail_mem_gb = (realmem - alloc_mem_mb) / 1024

    # Parse per-node GPU info
    delete node_total_gpu
    delete node_alloc_gpu
    has_gpu = 0
    if (gres_str != "") {
        ngres = split(gres_str, gres_arr, ",")
        for (g=1; g<=ngres; g++) {
            if (gres_arr[g] ~ /^gpu:/ || gres_arr[g] ~ /^=gpu:/) {
                sub(/^=/, "", gres_arr[g])
                ng = split(gres_arr[g], gpu_arr, ":")
                if (ng == 3) {
                    node_total_gpu[gpu_arr[2]] = (gpu_arr[3] + 0)
                    has_gpu = 1
                }
            }
        }
    }
    if (tres_str != "") {
        ntres = split(tres_str, tres_arr, ",")
        for (t=1; t<=ntres; t++) {
            if (tres_arr[t] ~ /^gres\/gpu:[^=]+=/ || tres_arr[t] ~ /^=gres\/gpu:[^=]+=/) {
                sub(/^=/, "", tres_arr[t])
                sub(/^gres\/gpu:/, "", tres_arr[t])
                split(tres_arr[t], ga, "=")
                node_alloc_gpu[ga[1]] = (ga[2] + 0)
            }
        }
    }

    # GPU nodes
    if (has_gpu) {
        for (gt in node_total_gpu) {
            tv = node_total_gpu[gt]
            av = tv - ((gt in node_alloc_gpu) ? node_alloc_gpu[gt] : 0)
            if (av <= 0) continue
            alloc_g = (gt in node_alloc_gpu) ? node_alloc_gpu[gt] : 0
            gkey = sprintf("%08d_%s_%s", 99999999 - av, name, gt)
            gpu_lines[gkey] = sprintf("%-15s %-10s %-10s %8d %8d %8d %8d %8.1f %8.1f",
                partitions, name, gt, av, alloc_g, avail_cpu, cpualloc, avail_mem_gb, alloc_mem_gb)
        }
    } else {
        # CPU-only nodes
        key = sprintf("%08d_%s", 99999999 - avail_cpu, name)
        cpu_lines[key] = sprintf("%-15s %-10s %8d %8d %8.1f %8.1f",
            partitions, name, avail_cpu, cpualloc, avail_mem_gb, alloc_mem_gb)
    }
} END {
    # Summary table
    for (p in mixed) parts[p]=1
    for (p in idle) parts[p]=1
    n=asorti(parts, sorted)
    printf "%-15s %6s %6s\n", "Partition", "Idle", "Mixed"
    printf "%-15s %6s %6s\n", "---------------", "------", "------"
    for (i=1; i<=n; i++) {
        p=sorted[i]
        iv = (p in idle) ? idle[p] : 0
        mv = (p in mixed) ? mixed[p] : 0
        printf "%-15s %6d %6d\n", p, iv, mv
    }

    # Mixed CPU node summary
    if (length(cpu_lines) > 0) {
        printf "\n"
        printf "Top mixed CPU nodes by available CPU:\n"
        printf "%-15s %-10s %8s %8s %8s %8s\n", "Partitions", "NodeName", "AvailCPU", "AllocCPU", "AvailRAM", "AllocRAM"
        printf "%-15s %-10s %8s %8s %8s %8s\n", "--------------", "----------", "--------", "--------", "--------", "--------"
        m=asorti(cpu_lines, sorted_keys)
        count=0
        for (i=1; i<=m && count<topn; i++) {
            printf "%s\n", cpu_lines[sorted_keys[i]]
            count++
        }
    }

    # Mixed GPU node summary
    if (length(gpu_lines) > 0) {
        printf "\n"
        printf "Top mixed GPU nodes by available GPU:\n"
        printf "%-15s %-10s %-10s %8s %8s %8s %8s %8s %8s\n",
            "Partitions", "NodeName", "GPU Type", "AvailGPU", "AllocGPU", "AvailCPU", "AllocCPU", "AvailRAM", "AllocRAM"
        printf "%-15s %-10s %-10s %8s %8s %8s %8s %8s %8s\n",
            "--------------", "----------", "----------", "--------", "--------", "--------", "--------", "--------", "--------"
        m = asorti(gpu_lines, gpu_sorted_keys)
        count=0
        for (i=1; i<=m && count<topn; i++) {
            printf "%s\n", gpu_lines[gpu_sorted_keys[i]]
            count++
        }
    }
}'
